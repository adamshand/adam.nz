{
	"name": "adam.nz",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"start": "node index.js",
		"dev": "vite dev --host --port 5176",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"buildtar": "pnpm build && tar -cvf ./deploy.tar --exclude='*.map' ./captain-definition ./Dockerfile ./package.json ./pnpm-lock.yaml ./build/*",
		"deploytar": "caprover deploy -t ./deploy.tar",
		"deployprod": "caprover deploy -h https://captain.ruru.haume.nz -a adam-nz -b main -p $( awk -F= '/^CAPROVER_PASS=/ {print $2}' ~/.env )"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/eslint": "^9.6.1",
		"@types/md5": "^2.3.6",
		"@types/node": "^25.9.5",
		"@types/quill": "^2.0.14",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.10.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"html-to-image": "^1.11.13",
		"html2canvas": "^1.4.1",
		"husky": "^9.1.7",
		"just-group-by": "^2.2.0",
		"just-sort-by": "^3.2.0",
		"pocketbase": "^0.26.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"quill": "^2.0.3",
		"sharp": "^0.34.5",
		"snarkdown": "^2.0.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"go-go-try": "^6.2.0",
		"stripe": "^20.4.1",
		"vite-node": "^5.3.0"
	}
}
